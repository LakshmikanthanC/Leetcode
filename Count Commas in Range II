Count Commas in Range II



class Solution {
public:
    long long countCommas(long long n) {
        long long result = 0;
        long long power = 1000;

        for (int c = 1; c <= 5; c++) {
            result += max(0LL, n - (power - 1));
            power *= 1000;
        }

        return result;
    }
};
