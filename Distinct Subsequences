Distinct Subsequences




class Solution {
public:
int f(int i, int j, string& s1, string& s2, vector<vector<int>>& dp) {
    if(j<0) return 1;
    if(i<0) return 0;
    
    if(dp[i][j] != -1) return dp[i][j];
    
    //not pick
    int not_pick = f(i-1, j, s1, s2, dp);
    //pick
    int pick = 0;
    if(s1[i] == s2[j]) {
        pick = f(i-1, j-1, s1, s2, dp);
    }
    
    return dp[i][j] = pick+not_pick;
}
    int numDistinct(string &s1, string &s2) {
        int n1 = s1.size();
        int n2 = s2.size();
        vector<vector<int>> dp(n1, vector<int>(n2, -1));
        int count = f(n1-1, n2-1, s1, s2, dp);
        return count;
    }

    
};
